---
title: "Online PDF Pro - Free PDF Tools: Merge, Compress, Sign, OCR & More"
description: "100% Free PDF tools: Merge, Split, Compress, Convert, Unlock, Watermark, Sign PDF, Image to Text (OCR) extractor. No registration, No watermark, Works on mobile."
keywords: "free pdf tools online, pdf merge online, compress pdf free, pdf editor online, convert pdf, sign pdf free, ocr pdf, pdf tools no signup"
bodyClass: tp-body
---
{% extends "base.njk" %}
{% block head %}
<style>
:root { --tp-bg: #f6f5f0; --tp-bg-alt: #efe9de; --tp-bg-dark: #1c1610; --tp-text: #2c2418; --tp-text-secondary: #6b5e4f; --tp-text-muted: #706558; --tp-accent: #8b6914; --tp-accent-hover: #a47d1b; --tp-border: #d9d0c3; --tp-card-bg: transparent; --tp-serif: 'Playfair Display', Georgia, 'Times New Roman', serif; --tp-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
[data-theme="dark"] { --tp-bg: #1a1714; --tp-bg-alt: #242019; --tp-bg-dark: #0f0d0a; --tp-text: #f0ebe2; --tp-text-secondary: #a89e8f; --tp-text-muted: #8c8273; --tp-accent: #d4a942; --tp-accent-hover: #e6be5a; --tp-border: #3a342a; --tp-card-bg: #2a2520; }
body.tp-body { background: var(--tp-bg) !important; color: var(--tp-text) !important; }
body.tp-body .header { background: rgba(246,245,240,0.97) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: 1px solid var(--tp-border) !important; box-shadow: none !important; }
[data-theme="dark"] body.tp-body .header { background: rgba(26,23,20,0.97) !important; border: 1px solid var(--tp-border) !important; }
body.tp-body .header .logo-text { color: var(--tp-text) !important; }
body.tp-body .header .nav-link { color: var(--tp-text-secondary) !important; }
body.tp-body .header .nav-link:hover { color: var(--tp-text) !important; }
.tp-hero { background: transparent; padding: 20px 24px 80px; text-align: center; position: relative; overflow: hidden; border-bottom: none; }
.tp-hero::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(139,105,20,0.06) 0%, transparent 70%); pointer-events: none; }
.tp-hero-label { font-family: var(--tp-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--tp-accent); margin-bottom: 16px; position: relative; }
.tp-hero-heading { font-family: var(--tp-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; line-height: 1.15; color: var(--tp-text); margin-bottom: 16px; letter-spacing: -0.01em; position: relative; white-space: nowrap; }
@media (max-width: 768px) { .tp-hero-heading, .tp-hero-subtitle { white-space: normal; } }
.tp-hero-heading em { font-style: italic; }
.tp-hero-subtitle { font-family: var(--tp-sans); font-size: 0.92rem; color: var(--tp-text-secondary); line-height: 1.7; max-width: 950px; margin: 0 auto 32px; position: relative; white-space: nowrap; }
.tp-search-wrap { max-width: 440px; margin: 0 auto; position: relative; }
.tp-search-wrap input { width: 100%; padding: 16px 20px 16px 48px; border: 1.5px solid var(--tp-border); background: var(--tp-card-bg); color: var(--tp-text); font-family: var(--tp-sans); font-size: 0.9rem; outline: none; transition: border-color 0.3s; }
.tp-search-wrap input:focus { border-color: var(--tp-accent); }
.tp-search-wrap input::placeholder { color: var(--tp-text-muted); }
.tp-search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--tp-text-muted); pointer-events: none; }
.tp-search-icon svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; }
.tp-main { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
.tp-category { padding: 56px 0 0; }
.tp-category-header { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
.tp-category-title { font-family: var(--tp-serif); font-size: 1.25rem; font-weight: 500; color: var(--tp-text); white-space: nowrap; }
.tp-category-line { flex: 1; height: 1px; background: var(--tp-border); }
.tp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
.tp-card { display: flex; align-items: center; gap: 16px; padding: 20px 18px; background: var(--tp-card-bg); border: 1px solid var(--tp-border); text-decoration: none; color: inherit; transition: all 0.3s ease; position: relative; overflow: hidden; }

.tp-card:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(44,36,24,0.06); border-color: var(--tp-accent); }

.tp-card-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tp-card-icon svg { width: 22px; height: 22px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.tp-card-name { font-family: var(--tp-serif); font-size: 0.95rem; font-weight: 500; color: var(--tp-text); margin-bottom: 2px; }
.tp-card-desc { font-family: var(--tp-sans); font-size: 0.75rem; color: var(--tp-text-muted); line-height: 1.4; }
.tp-card.coming-soon { opacity: 0.45; cursor: default; pointer-events: none; }
.tp-fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.tp-fade-up.visible { opacity: 1; transform: translateY(0); }

@media (max-width: 768px) { 
    .tp-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .tp-card { flex-direction: column; text-align: center; padding: 16px 12px; gap: 10px; }
    .tp-card-icon { margin: 0 auto; width: 40px; height: 40px; }
    .tp-card-icon svg { width: 20px; height: 20px; }
    .tp-card-name { font-size: 0.82rem; }
    .tp-card-desc { font-size: 0.68rem; line-height: 1.3; }
    .tp-hero { padding: 80px 20px 56px; } 
    .tp-category { padding: 40px 0 0; } 
}
</style>
{% endblock %}

