---
title: "Free Online PDF Tools"
description: "45+ browser-based document tools for PDF, image, conversion, OCR and productivity workflows. Processing details are shown on each tool; no registration is required for local tools."
permalink: /tools.html
bodyClass: tp-body
---
{% extends "base.njk" %}
{% block head %}
<style>
:root { --tp-bg: #f6f5f0; --tp-bg-alt: #efe9de; --tp-bg-dark: #1c1610; --tp-text: #2c2418; --tp-text-secondary: #6b5e4f; --tp-text-muted: #706558; --tp-accent: #8b6914; --tp-accent-hover: #a47d1b; --tp-border: #d9d0c3; --tp-card-bg: transparent; --tp-serif: 'Playfair Display', Georgia, 'Times New Roman', serif; --tp-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
[data-theme="dark"] { --tp-bg: #1a1714; --tp-bg-alt: #242019; --tp-bg-dark: #0f0d0a; --tp-text: #f0ebe2; --tp-text-secondary: #a89e8f; --tp-text-muted: #8c8273; --tp-accent: #d4a942; --tp-accent-hover: #e6be5a; --tp-border: #3a342a; --tp-card-bg: #2a2520; }
body.tp-body { background: var(--tp-bg) !important; color: var(--tp-text) !important; }
body.tp-body .header { background: rgba(246,245,240,0.97) !important; backdrop-filter: blur(16px) !important; -webkit-backdrop-filter: blur(16px) !important; border: 1px solid var(--tp-border) !important; box-shadow: none !important; }
[data-theme="dark"] body.tp-body .header { background: rgba(26,23,20,0.97) !important; border: 1px solid var(--tp-border) !important; }
body.tp-body .header .logo-text { color: var(--tp-text) !important; }
body.tp-body .header .nav-link { color: var(--tp-text-secondary) !important; }
body.tp-body .header .nav-link:hover { color: var(--tp-text) !important; }
.tp-hero { background: transparent; padding: 20px 24px 80px; text-align: center; position: relative; overflow: hidden; border-bottom: none; }
.tp-hero::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(139,105,20,0.06) 0%, transparent 70%); pointer-events: none; }
.tp-hero-label { font-family: var(--tp-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--tp-accent); margin-bottom: 16px; position: relative; }
.tp-hero-heading { font-family: var(--tp-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; line-height: 1.15; color: var(--tp-text); margin-bottom: 16px; letter-spacing: -0.01em; position: relative; white-space: normal; text-wrap: balance; }
@media (max-width: 768px) { .tp-hero-heading, .tp-hero-subtitle { white-space: normal; } }
.tp-hero-heading em { font-style: italic; }
.tp-hero-subtitle { font-family: var(--tp-sans); font-size: 0.92rem; color: var(--tp-text-secondary); line-height: 1.7; max-width: 950px; margin: 0 auto 32px; position: relative; white-space: normal; text-wrap: balance; }
.tp-search-wrap { max-width: 440px; margin: 0 auto; position: relative; }
.tp-search-wrap input { width: 100%; padding: 16px 20px 16px 48px; border: 1.5px solid var(--tp-border); background: var(--tp-card-bg); color: var(--tp-text); font-family: var(--tp-sans); font-size: 0.9rem; outline: none; transition: border-color 0.3s; }
.tp-search-wrap input { min-height: 48px; }
.tp-search-wrap input:focus { border-color: var(--tp-accent); }
.tp-search-wrap input::placeholder { color: var(--tp-text-muted); }
.tp-search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--tp-text-muted); pointer-events: none; }
.tp-search-icon svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; }
.tp-main { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
.tp-category { padding: 56px 0 0; }
.tp-category-header { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
.tp-category-title { font-family: var(--tp-serif); font-size: 1.25rem; font-weight: 500; color: var(--tp-text); white-space: nowrap; }
.tp-category-line { flex: 1; height: 1px; background: var(--tp-border); }
.tp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
.tp-card { display: flex; align-items: center; gap: 16px; padding: 20px 18px; background: var(--tp-card-bg); border: 1px solid var(--tp-border); text-decoration: none; color: inherit; transition: all 0.3s ease; position: relative; overflow: hidden; }
.tp-card:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(44,36,24,0.06); border-color: var(--tp-accent); }
.tp-card-icon { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.tp-card-icon svg { width: 22px; height: 22px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.tp-card-name { font-family: var(--tp-serif); font-size: 0.95rem; font-weight: 500; color: var(--tp-text); margin-bottom: 2px; }
.tp-card-desc { font-family: var(--tp-sans); font-size: 0.75rem; color: var(--tp-text-muted); line-height: 1.4; }
.tp-card.coming-soon { opacity: 0.45; cursor: default; pointer-events: none; }
.tp-fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.tp-fade-up.visible { opacity: 1; transform: translateY(0); }

@media (max-width: 768px) {
    .tp-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .tp-card { flex-direction: column; text-align: center; padding: 16px 12px; gap: 10px; }
    .tp-card-icon { margin: 0 auto; width: 40px; height: 40px; }
    .tp-card-icon svg { width: 20px; height: 20px; }
    .tp-card-name { font-size: 0.82rem; }
    .tp-card-desc { font-size: 0.68rem; line-height: 1.3; }
    .tp-hero { padding: 80px 20px 56px; }
    .tp-category { padding: 40px 0 0; }
}
</style>
{% endblock %}

{% block content %}
<!-- ═══════ HERO ═══════ -->
<section class="tp-hero">
    <p class="tp-hero-label">{{ toolRegistry.tools | length }} Free Tools — No Signup Needed</p>
    <h1 class="tp-hero-heading">All Your PDF Tools <em>in One Place</em></h1>
    <p class="tp-hero-subtitle">Merge, compress, convert, sign, and edit PDFs in seconds. 100% free, easy to use, no watermarks</p>
    <div class="tp-search-wrap">
        <div class="tp-search-icon"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div>
        <input type="text" id="toolSearch" placeholder="Search tools..." autocomplete="off"/>
    </div>
</section>

<!-- ═══════ TOOLS ═══════ -->
<div class="tp-main" id="tools-section">

{% for category in toolRegistry.categories %}
<div class="tp-category tp-fade-up">
    <div class="tp-category-header">
        <h2 class="tp-category-title">{{ category.name }}</h2>
        <div class="tp-category-line"></div>
    </div>
    <div class="tp-grid">
        {% for tool in category.tools %}
        <a class="tp-card" href="{{ tool.href | url }}">
            <div class="tp-card-icon" style="background: {{ tool.color }};"><svg viewBox="0 0 24 24">{{ tool.svg | safe }}</svg></div>
            <div><div class="tp-card-name">{{ tool.name }}</div><div class="tp-card-desc">{{ tool.desc }}</div></div>
        </a>
        {% endfor %}
</div>
</div>
{% endfor %}

</div><!-- end tp-main -->

<!-- ═══════ SMART DROP OVERLAY ═══════ -->
<div id="homeDropOverlay" style="position:fixed;inset:0;z-index:99999;background:rgba(28,22,16,0.85);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transition:opacity 0.2s,visibility 0.2s;pointer-events:none;">
<div style="text-align:center;padding:48px 64px;border:2px dashed rgba(212,169,66,0.4);border-radius:0;background:rgba(212,169,66,0.05);">
<div style="width:80px;height:80px;margin:0 auto 20px;border-radius:50%;background:rgba(212,169,66,0.1);display:flex;align-items:center;justify-content:center;color:#d4a942;">
<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
</div>
<p style="font-size:1.5rem;font-weight:700;color:#f0ebe2;margin-bottom:8px;font-family:'Playfair Display',serif;">Drop your file here</p>
<p style="font-size:0.9rem;color:rgba(240,235,226,0.5);font-family:'Inter',sans-serif;">We'll help you pick the right tool</p>
</div>
</div>

<script>
// Search filtering
(function() {
    var input = document.getElementById('toolSearch');
    if (!input) return;
    input.addEventListener('input', function() {
        var q = this.value.toLowerCase().trim();
        var cards = document.querySelectorAll('.tp-card');
        var categories = document.querySelectorAll('.tp-category');
        cards.forEach(function(card) {
            var name = card.querySelector('.tp-card-name');
            var desc = card.querySelector('.tp-card-desc');
            var text = (name ? name.textContent : '') + ' ' + (desc ? desc.textContent : '');
            card.style.display = text.toLowerCase().includes(q) || q === '' ? 'flex' : 'none';
        });
        categories.forEach(function(cat) {
            var visible = cat.querySelectorAll('.tp-card[style*="flex"], .tp-card:not([style])');
            var hasVisible = false;
            visible.forEach(function(c) { if (c.style.display !== 'none') hasVisible = true; });
            cat.style.display = hasVisible || q === '' ? 'block' : 'none';
        });
    });
})();
// Fade-up animations
(function() {
    if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.tp-fade-up').forEach(function(el) { el.classList.add('visible'); });
        return;
    }
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
        });
    }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
    document.querySelectorAll('.tp-fade-up').forEach(function(el) { observer.observe(el); });
})();
// Smart drop zone
(function() {
    var overlay = document.getElementById('homeDropOverlay');
    if (!overlay) return;
    var modal = null;
    var closeModalButton = null;
    var lastFocusedElement = null;
    function bindToolPickerModal() {
        if (modal) return;
        modal = document.getElementById('homeDropModal');
        closeModalButton = document.getElementById('dropModalClose');
        if (closeModalButton) closeModalButton.addEventListener('click', closeToolPicker);
    }
    function closeToolPicker() {
        if (!modal) return;
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        modal.style.display = 'none';
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') lastFocusedElement.focus();
    }
    bindToolPickerModal();
    if (!modal) document.addEventListener('DOMContentLoaded', bindToolPickerModal, { once: true });
    document.addEventListener('keydown', function(event) {
        if (!modal || modal.hidden) return;
        if (event.key === 'Escape') {
            event.preventDefault();
            closeToolPicker();
            return;
        }
        if (event.key === 'Tab') {
            var focusable = modal.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])');
            if (!focusable.length) return;
            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
            else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
    });
    var dragCounter = 0;
    var toolMap = {
        pdf: [
            { name: 'To Word', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>', href: 'tools/pdf-to-word.html' },
            { name: 'Compress', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m8 17 4 4 4-4"/></svg>', href: 'tools/compress-pdf.html' },
            { name: 'Merge', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>', href: 'tools/merge-pdf.html' },
            { name: 'Split', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.47" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>', href: 'tools/split-pdf.html' },
            { name: 'Read', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>', href: 'pdf-reader.html' },
            { name: 'Sign', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>', href: 'tools/sign-pdf.html' }
        ],
        image: [
            { name: 'To PDF', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>', href: 'tools/jpg-to-pdf.html' },
            { name: 'Extract Text', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>', href: 'tools/image-to-text.html' }
        ],
        word: [
            { name: 'To PDF', svg: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>', href: 'tools/word-to-pdf.html' }
        ]
    };
    document.addEventListener('dragenter', function(e) { e.preventDefault(); dragCounter++; overlay.style.opacity='1'; overlay.style.visibility='visible'; overlay.style.pointerEvents='auto'; });
    document.addEventListener('dragleave', function(e) { e.preventDefault(); dragCounter--; if(dragCounter<=0){dragCounter=0; overlay.style.opacity='0'; overlay.style.visibility='hidden'; overlay.style.pointerEvents='none';} });
    document.addEventListener('dragover', function(e) { e.preventDefault(); });
    overlay.addEventListener('drop', function(e) {
        e.preventDefault(); dragCounter=0; overlay.style.opacity='0'; overlay.style.visibility='hidden'; overlay.style.pointerEvents='none';
        var files=e.dataTransfer.files; if(!files||files.length===0) return;
        var file=files[0]; var isPDF=file.type==='application/pdf'||file.name.toLowerCase().endsWith('.pdf');
        var isImage=file.type.startsWith('image/');
        var isWord=file.name.toLowerCase().endsWith('.docx')||file.name.toLowerCase().endsWith('.doc');
        var tools=isPDF?toolMap.pdf:(isImage?toolMap.image:(isWord?toolMap.word:toolMap.pdf));
        var fileName=document.getElementById('dropModalFileName');
        if(!fileName) return;
        fileName.textContent=file.name+' ('+(file.size/1024/1024).toFixed(1)+' MB)';
        var ad=document.getElementById('dropModalActions');
        if(!ad) return;
        ad.replaceChildren();
        tools.forEach(function(t) {
            var link = document.createElement('a');
            link.href = t.href;
            link.style.cssText = 'display:flex;align-items:center;gap:10px;padding:14px 16px;background:var(--tp-bg-alt);border:1px solid var(--tp-border);text-decoration:none;color:var(--tp-text);font-weight:500;font-size:0.9rem;font-family:Inter,sans-serif;transition:all 0.2s;';
            link.addEventListener('mouseenter', function() { link.style.borderColor = 'var(--tp-accent)'; });
            link.addEventListener('mouseleave', function() { link.style.borderColor = 'var(--tp-border)'; });
            var icon = document.createElement('span');
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = '↗';
            icon.style.fontSize = '1.3rem';
            var label = document.createElement('span');
            label.textContent = t.name;
            link.append(icon, label);
            ad.appendChild(link);
        });
        if(modal) {
            lastFocusedElement = document.activeElement;
            modal.hidden = false;
            modal.setAttribute('aria-hidden', 'false');
            modal.style.display='flex';
            setTimeout(function() { if (closeModalButton) closeModalButton.focus(); }, 0);
        }
    });
})();
</script>

<!-- ═══════ TOOL PICKER MODAL ═══════ -->
<div id="homeDropModal" role="dialog" aria-modal="true" aria-labelledby="dropModalTitle" aria-describedby="dropModalFileName" aria-hidden="true" hidden style="position:fixed;inset:0;z-index:100000;background:rgba(28,22,16,0.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);display:none;align-items:center;justify-content:center;">
<div style="background:var(--tp-card-bg);border:1px solid var(--tp-border);border-radius:0;padding:36px 32px;max-width:480px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
<div style="text-align:center;margin-bottom:24px;">
<h2 id="dropModalTitle" style="font-size:1.25rem;font-weight:600;color:var(--tp-text);margin-bottom:12px;font-family:'Playfair Display',serif;">Choose a tool</h2>
<p style="font-size:1.1rem;font-weight:500;color:var(--tp-text);margin-bottom:4px;font-family:'Playfair Display',serif;" id="dropModalFileName">file.pdf</p>
<p style="font-size:0.85rem;color:var(--tp-text-muted);font-family:'Inter',sans-serif;">What would you like to do?</p>
</div>
<div id="dropModalActions" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;"></div>
<button id="dropModalClose" type="button" style="display:block;margin:20px auto 0;padding:10px 24px;background:transparent;border:1px solid var(--tp-border);border-radius:0;color:var(--tp-text-muted);cursor:pointer;font-size:0.85rem;font-family:'Inter',sans-serif;">Cancel</button>
</div>
</div>
{% endblock %}
