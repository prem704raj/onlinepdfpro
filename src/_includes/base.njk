<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/meta.njk" %}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://www.googletagmanager.com https://pagead2.googlesyndication.com https://pl29768747.effectivecpmnetwork.com https://5gvci.com https://n6wxm.com https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; object-src 'none'; connect-src 'self' https://api.ocr.space https://api.imgbb.com https://huggingface.co https://*.huggingface.co https://cdn.jsdelivr.net blob: data:; worker-src 'self' blob:; frame-ancestors 'none';">
  <link href="https://cdn.jsdelivr.net" rel="preconnect"/>
  <link href="https://unpkg.com" rel="preconnect"/>
  <link href="https://cdn.jsdelivr.net" rel="dns-prefetch"/>
  <link href="{{ '/css/style.css' | url }}" rel="stylesheet"/>
  <link href="{{ '/css/mobile-fix-v2.css' | url }}" rel="stylesheet"/>
  <link href="{{ '/css/tools-v2.css' | url }}" rel="stylesheet"/>
  <link href="{{ '/feed.xml' | url }}" rel="alternate" title="OnlinePDFPro Blog" type="application/rss+xml"/>
  {% include "partials/scripts.njk" %}
  {% block head %}{% endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip-link" href="#main">Skip to main content</a>
{% include "partials/header.njk" %}
<main id="main">
{% block content %}{{ content | safe }}{% endblock %}
</main>
{% block footer %}
  {% include "partials/footer.njk" %}
{% endblock %}
<script defer src="{{ '/js/app.js' | url }}"></script>
<script>if ('serviceWorker' in navigator) { navigator.serviceWorker.register('{{ '/sw.js' | url }}'); }</script>
{% block scripts %}{% endblock %}
</body>
</html>
