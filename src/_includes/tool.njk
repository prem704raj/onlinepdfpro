{% extends "base.njk" %}
{% block head %}
<style>
.tp-hero { padding: 20px 24px 80px; text-align: center; position: relative; overflow: hidden; }
.tp-hero::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 600px; height: 400px; background: radial-gradient(ellipse, rgba(139,105,20,0.06) 0%, transparent 70%); pointer-events: none; }
.tp-hero-label { font-family: 'Inter', sans-serif; font-size: 0.65rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--tp-accent, #8b6914); margin-bottom: 16px; position: relative; }
.tp-hero-heading { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; line-height: 1.15; color: var(--tp-text, #2c2418); margin-bottom: 16px; letter-spacing: -0.01em; position: relative; }
.tp-hero-heading em { font-style: italic; color: var(--tp-accent, #8b6914); }
.tp-hero-subtitle { font-family: 'Inter', sans-serif; font-size: 0.92rem; color: var(--tp-text-secondary, #6b5e4f); line-height: 1.7; max-width: 950px; margin: 0 auto 32px; position: relative; }
</style>
{% endblock %}
{% block content %}
<section class="tp-hero">
  <p class="tp-hero-label">{{ toolTag or 'Free PDF Tool' }}</p>
  <h1 class="tp-hero-heading">{{ toolTitle }} <em>{{ toolSubtitle or '' }}</em></h1>
  <p class="tp-hero-subtitle">{{ toolDescription }}</p>
</section>
<div class="tp-main" style="max-width: 1100px; margin: 0 auto; padding: 0 24px;">
  {{ content | safe }}
</div>
{% endblock %}
