<script>
(function() {
    var saved = localStorage.getItem('doctools-theme');
    var validSaved = saved === 'light' || saved === 'dark';
    var systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', validSaved ? saved : (systemPrefersDark ? 'dark' : 'light'));
})();
</script>
