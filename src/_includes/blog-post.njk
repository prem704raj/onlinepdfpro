{% extends "base.njk" %}
{% block head %}
<style>
.blog-content { max-width: 800px; margin: 120px auto 60px; padding: 0 24px; line-height: 1.8; }
.blog-content h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; margin-bottom: 24px; color: var(--text-primary, #f0ebe2); }
.blog-content h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; margin: 40px 0 16px; color: var(--text-primary, #f0ebe2); }
.blog-content h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.2rem; margin: 32px 0 12px; color: var(--text-primary, #f0ebe2); }
.blog-content p { margin-bottom: 16px; color: var(--text-secondary, #a89e8f); font-family: 'Inter', sans-serif; }
.blog-content a { color: var(--accent, #d4a942); text-decoration: underline; }
.blog-content ul, .blog-content ol { margin: 16px 0; padding-left: 24px; color: var(--text-secondary, #a89e8f); }
.blog-content li { margin-bottom: 8px; }
.blog-content img { max-width: 100%; height: auto; border-radius: 8px; margin: 24px 0; }
.blog-cta { background: var(--surface-1, #2a2520); border: 1px solid var(--border, #3a342a); padding: 32px; text-align: center; margin: 40px 0; }
.blog-cta h3 { font-family: 'Playfair Display', Georgia, serif; margin-bottom: 12px; color: var(--text-primary, #f0ebe2); }
.blog-cta p { margin-bottom: 20px; color: var(--text-secondary, #a89e8f); }
.btn-primary { display: inline-block; padding: 14px 32px; background: var(--accent, #d4a942); color: var(--btn-primary-text, #1a1714); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: background 0.2s; }
.btn-primary:hover { background: var(--accent-hover, #e6be5a); }
.blog-footer { text-align: center; padding: 40px 20px; color: var(--text-secondary); border-top: 1px solid var(--border); margin-top: 40px; }
.blog-footer a { color: var(--accent); text-decoration: none; font-weight: 500; }
.blog-footer a:hover { text-decoration: none; }
</style>
{% endblock %}
{% block content %}
<div class="blog-content">
  {{ content | safe }}
  {% if toolLink %}
  <div class="blog-cta">
    <h3>{{ ctaTitle or 'Try It Free' }}</h3>
    <p>{{ ctaDescription or 'No signup required. 100% free.' }}</p>
    <a href="{{ toolLink }}" class="btn-primary">{{ ctaButton or 'Use the Tool Now' }}</a>
  </div>
  {% endif %}
</div>
{% endblock %}
{% block footer %}
  {% include "partials/footer-minimal.njk" %}
{% endblock %}
