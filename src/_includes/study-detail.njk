{% set pageProduct = detailProduct or storeProducts["dbms-notes"] %}
{% set reviewContent = productReviews[pageProduct.id] %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if detailProduct %}{{ detailProduct.title }} — {{ detailProduct.pageCount }}-page PDF Study Draft{% else %}View Study Material{% endif %} | OnlinePDFPro</title>
    <meta name="description" content="{% if detailProduct %}{{ detailProduct.description }} AI-assisted draft. Preview five pages before purchase.{% else %}View study material details and a five-page preview before purchase on OnlinePDFPro.{% endif %}">
    <meta name="robots" content="{% if detailProduct %}index, follow{% else %}noindex, follow{% endif %}">
    <link rel="canonical" href="https://onlinepdfpro.com{% if detailProduct %}{{ detailProduct.url }}{% else %}/viewstudymaterials.html{% endif %}">
    {% if detailProduct %}
    <meta property="og:title" content="{{ detailProduct.title }}">
    <meta property="og:description" content="{{ detailProduct.disclosure }}">
    <meta property="og:image" content="https://onlinepdfpro.com{{ detailProduct.image }}">
    <script type="application/ld+json">{
      "@context": "https://schema.org", "@type": "Product",
      "name": {{ detailProduct.title | json | safe }},
      "description": {{ (detailProduct.description + ' ' + detailProduct.disclosure) | json | safe }},
      "image": "https://onlinepdfpro.com{{ detailProduct.image }}",
      "url": "https://onlinepdfpro.com{{ detailProduct.url }}",
      "offers": { "@type": "Offer", "price": {{ detailProduct.price | json | safe }}, "priceCurrency": "INR", "url": "https://onlinepdfpro.com{{ detailProduct.url }}" }
    }</script>
    {% endif %}
    <meta name="theme-color" content="#171512">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/mobile-fix-v2.css">
    <style>
        :root {
            --sm-bg: #f7f5f0;
            --sm-surface: #fffdf9;
            --sm-surface-soft: #f1ece3;
            --sm-text: #211d18;
            --sm-muted: #786f64;
            --sm-border: #e5ded3;
            --sm-accent: #a97822;
            --sm-accent-dark: #8f641b;
            --sm-serif: "Playfair Display", Georgia, serif;
            --sm-sans: "DM Sans", Inter, sans-serif;
        }
        [data-theme="dark"] {
            --sm-bg: #171512;
            --sm-surface: #211e1a;
            --sm-surface-soft: #29241e;
            --sm-text: #f6f0e7;
            --sm-muted: #aea397;
            --sm-border: #3a342c;
            --sm-accent: #d5a943;
            --sm-accent-dark: #e1b650;
        }
        html { background: var(--sm-bg); }
        body.sm-body { min-height: 100vh; margin: 0; padding-top: 0; background: var(--sm-bg) !important; color: var(--sm-text) !important; font-family: var(--sm-sans); }
        body.sm-body main { padding-top: 0 !important; }
        body.sm-body .header { position: relative; background: var(--sm-bg) !important; border-bottom: 1px solid var(--sm-border) !important; box-shadow: none !important; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        body.sm-body .header .logo-text, body.sm-body .header .nav-link, body.sm-body .header .theme-toggle, body.sm-body .header .menu-toggle { color: var(--sm-text) !important; }
        body.sm-body .header .nav-link:hover { color: var(--sm-accent) !important; }
        .preview-dialog { width: min(92vw, 760px); max-height: 92vh; max-height: 92dvh; overflow-y: auto; padding: 0; border: 1px solid var(--sm-border); background: var(--sm-surface); color: var(--sm-text); box-shadow: 0 30px 100px rgba(0,0,0,.35); }
        .preview-dialog::backdrop { background: rgba(20,17,13,.72); backdrop-filter: blur(4px); }
        .dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 17px 20px; border-bottom: 1px solid var(--sm-border); }
        .dialog-head h2 { margin: 0; font: 500 1.25rem var(--sm-serif); }
        .dialog-close { width: 44px; height: 44px; flex-shrink: 0; border: 1px solid var(--sm-border); background: transparent; color: var(--sm-text); font-size: 1.2rem; cursor: pointer; }
        .dialog-body { display: grid; place-items: center; padding: 22px; background: var(--sm-surface-soft); }
        .dialog-body img { display: block; width: auto; max-width: 100%; max-height: 68vh; max-height: 60dvh; background: #fff; box-shadow: 0 15px 40px rgba(0,0,0,.22); }
        .dialog-footer { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 13px 20px; border-top: 1px solid var(--sm-border); color: var(--sm-muted); font-size: .76rem; }
        .dialog-nav { display: flex; gap: 8px; }
        .dialog-nav button { min-width: 44px; min-height: 44px; border: 1px solid var(--sm-border); background: transparent; color: var(--sm-text); cursor: pointer; }
        .dialog-nav button:disabled { opacity: .35; cursor: not-allowed; }
        .store-header-btn { position: relative; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--sm-border); border-radius: 50%; background: transparent; color: var(--sm-text); cursor: pointer; }
        .cart-count { position: absolute; top: -4px; right: -4px; min-width: 17px; height: 17px; display: none; align-items: center; justify-content: center; padding: 0 4px; border-radius: 999px; background: var(--sm-accent); color: #fff; font-size: 10px; font-weight: 700; }
        .cart-count:not([hidden]) { display: flex; }
        .profile-menu-wrap { position: relative; }
        .profile-menu-wrap:not([hidden]) { display: block; }
        .profile-avatar, .profile-initial { width: 36px; height: 36px; border-radius: 50%; }
        .profile-avatar { object-fit: cover; }
        .profile-initial { display: flex; align-items: center; justify-content: center; background: var(--sm-accent); color: #fff; font-weight: 700; }
        .profile-avatar[hidden], .profile-initial[hidden] { display: none !important; }
        .profile-dropdown { position: absolute; top: calc(100% + 10px); right: 0; z-index: 20; width: 220px; padding: 8px; border: 1px solid var(--sm-border); background: var(--sm-surface); box-shadow: 0 18px 50px rgba(0,0,0,.16); }
        .profile-dropdown-user { padding: 10px 12px; }
        .profile-dropdown-user strong, .profile-dropdown-user span { display: block; }
        .profile-dropdown-user span { margin-top: 4px; color: var(--sm-muted); font-size: .75rem; overflow: hidden; text-overflow: ellipsis; }
        .profile-divider { height: 1px; margin: 4px 0; background: var(--sm-border); }
        .profile-dropdown a, .profile-dropdown button { display: block; width: 100%; padding: 10px 12px; border: 0; background: transparent; color: var(--sm-text); font: .84rem var(--sm-sans); text-align: left; text-decoration: none; cursor: pointer; }
        .profile-dropdown a:hover, .profile-dropdown button:hover { background: rgba(120,111,100,.12); }
        .cart-overlay { position: fixed; inset: 0; z-index: 10000; background: rgba(0,0,0,.45); opacity: 0; visibility: hidden; transition: .2s; }
        .cart-overlay.open { opacity: 1; visibility: visible; }
        .cart-drawer { position: fixed; top: 0; right: 0; z-index: 10001; width: min(420px, 100%); height: 100vh; height: 100dvh; display: flex; flex-direction: column; box-sizing: border-box; transform: translateX(100%); border-left: 1px solid var(--sm-border); background: var(--sm-bg); transition: transform .25s ease; }
        .cart-drawer.open { transform: translateX(0); }
        .cart-drawer-header { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 24px; border-bottom: 1px solid var(--sm-border); }
        .cart-drawer-header h2 { margin: 4px 0 0; font: 500 1.45rem var(--sm-serif); }
        .cart-small-label { color: var(--sm-accent); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }
        .cart-close { width: 44px; height: 44px; flex-shrink: 0; border: 0; background: transparent; color: var(--sm-text); font-size: 1.7rem; cursor: pointer; }
        .cart-items { flex: 1; min-height: 0; overscroll-behavior: contain; overflow-y: auto; padding: 20px 24px; }
        .cart-item { display: flex; justify-content: space-between; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--sm-border); }
        .cart-item-info { min-width: 0; overflow-wrap: anywhere; }
        .cart-item-info strong, .cart-item-info span { display: block; }
        .cart-item-info span { margin-top: 6px; color: var(--sm-accent); font-weight: 700; }
        .cart-remove { min-width: 44px; min-height: 44px; border: 0; background: none; color: #b91c1c; cursor: pointer; }
        .cart-empty { padding: 60px 20px; color: var(--sm-muted); text-align: center; }
        .cart-footer { flex-shrink: 0; padding: 22px 24px; padding-bottom: max(22px, env(safe-area-inset-bottom)); border-top: 1px solid var(--sm-border); }
        .cart-total-row { display: flex; justify-content: space-between; margin-bottom: 18px; }
        .cart-checkout-btn { width: 100%; padding: 15px; border: 0; background: var(--sm-accent); color: #fff; font-weight: 700; cursor: pointer; }
        .cart-checkout-message { margin-bottom: 16px; padding: 12px 14px; border: 1px solid var(--sm-accent); color: var(--sm-text); font-size: .85rem; line-height: 1.5; }
        .cart-checkout-message a { display: inline-block; margin-top: 6px; color: var(--sm-accent); font-weight: 700; }
        .cart-secure-text { margin: 12px 0 0; color: var(--sm-muted); font-size: .7rem; text-align: center; }
        .detail-error { max-width: 560px; margin: 120px auto; padding: 40px; border: 1px solid var(--sm-border); background: var(--sm-surface); text-align: center; }
        .detail-error h1 { margin-top: 0; font: 500 2rem var(--sm-serif); }
        .detail-error a { color: var(--sm-accent); font-weight: 700; }
    </style>
    <link rel="stylesheet" href="/css/product-detail.css">
    <script>
        (function () {
            var savedTheme = localStorage.getItem('doctools-theme');
            var theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        }());
    </script>
</head>
<body class="sm-body">
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="header">
        <div class="header-content">
            <a class="logo" href="/"><img class="logo-icon" src="/logo.png" alt="" aria-hidden="true"><span class="logo-text">OnlinePDFPro</span></a>
            <nav class="nav" id="nav"><a class="nav-link" href="/tools.html">PDF Tools</a><a class="nav-link active" href="/study-materials.html">Study Materials</a></nav>
            <div class="header-actions">
                <button class="store-header-btn" type="button" onclick="openCart()" aria-label="Shopping cart" title="Cart"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M3 4h2l2.4 10.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6"/></svg><span class="cart-count" hidden>0</span></button>
                <div class="profile-menu-wrap" id="profileMenuWrap" hidden><button class="store-header-btn profile-trigger" id="profileTrigger" type="button" aria-label="My account" aria-expanded="false"><img id="profileAvatar" class="profile-avatar" alt="" hidden><span id="profileInitial" class="profile-initial">U</span></button><div class="profile-dropdown" id="profileDropdown" hidden><div class="profile-dropdown-user"><strong id="profileName">User</strong><span id="profileEmail"></span></div><div class="profile-divider"></div><a href="/library.html">My Library</a><button type="button" onclick="logout()">Sign Out</button></div></div>
                <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode"><span class="theme-icon-light"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span><span class="theme-icon-dark"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg></span></button><button class="menu-toggle" id="menuToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav">☰</button>
            </div>
        </div>
    </header>

    <main id="main" class="detail-main">
        <div id="detailContent" class="detail-shell">
            <a class="back-link" href="/study-materials.html">← All study materials</a>
            <div class="detail-layout">
                <section class="product-intro" aria-labelledby="productTitle">
                    <p class="eyebrow" id="productEyebrow">The study shelf / Database systems</p>
                    <div class="product-badges"><span>Digital study guide</span><span class="draft-badge">AI-assisted draft</span></div>
                    <h1 id="productTitle">{{ pageProduct.title }}</h1>
                    <p class="product-description" id="productDescription">{{ pageProduct.description }}</p>
                    <div class="facts" aria-label="Product facts"><div class="fact"><strong id="pageCount">{{ pageProduct.pageCount }}</strong><span>Pages</span></div><div class="fact"><strong id="format">{{ pageProduct.format }}</strong><span>File format</span></div><div class="fact"><strong id="factPrice">₹{{ pageProduct.price }}</strong><span>One-time</span></div></div>
                    <nav class="product-jump-links" aria-label="Product sections"><a href="#previewHeading">See the preview ↗</a><a href="#includedHeading">What's inside</a><a href="#reviewsHeading">Reviews</a></nav>
                </section>
                <aside class="purchase-summary" aria-labelledby="purchaseHeading">
                    <p class="eyebrow">Keep a copy for revision</p><h2 id="purchaseHeading">Get the complete PDF</h2>
                    <div class="purchase-top"><div><span class="price" id="productPrice">₹{{ pageProduct.price }}</span><span class="price-meta" id="priceMeta">{{ pageProduct.format }} · {{ pageProduct.pageCount }} pages</span></div><span class="one-time-label">One-time payment</span></div>
                    <p class="disclosure" id="disclosure"><strong>Before you buy.</strong> {{ pageProduct.disclosure }}</p>
                    <div class="purchase-actions"><button class="detail-buy" id="buyButton" type="button">Buy PDF · ₹{{ pageProduct.price }}</button><button class="detail-cart" id="addCartButton" type="button">Add to cart</button></div>
                    <p id="purchaseStatus" role="status" aria-live="polite"></p><p class="checkout-note">Sign in to keep this purchase in your Library. Payment is processed through Razorpay.</p>
                    <ul class="purchase-checklist"><li>One digital PDF; no printed book</li><li>Download after payment verification</li><li>Return to My Library to access it again</li></ul>
                    <p class="delivery-note" id="deliveryNote">{{ pageProduct.deliveryNote }}</p>
                    <div class="purchase-support"><a href="/refund.html">Read the refund policy</a><a href="mailto:support@onlinepdfpro.com">Need help?</a></div>
                    <noscript><p>Enable JavaScript to use the cart and checkout. The preview links still open the sample pages.</p></noscript>
                </aside>
                <section class="preview-card" aria-labelledby="previewHeading"><div class="preview-heading"><div><p class="eyebrow">Try before you decide</p><h2 id="previewHeading">A look inside the notes</h2></div><span class="preview-count" id="previewCount">5-page preview</span></div><div id="previewGrid" class="preview-grid" aria-label="Five-page preview">{% for preview in pageProduct.previewPages %}<a class="preview-thumb" href="{{ preview }}"><img src="{{ preview }}" width="612" height="792" alt="{{ pageProduct.title }} preview page {{ loop.index }}" loading="lazy"><span>Page {{ loop.index }}</span></a>{% endfor %}</div><p class="preview-help">Select a page to read it at a larger size. These five pages are a sample; the complete PDF has {{ pageProduct.pageCount }} pages.</p></section>
                <section class="coverage-card" aria-labelledby="includedHeading"><p class="eyebrow">The contents</p><h2 id="includedHeading">What you'll study</h2><ul class="included-list" id="includedList">{% for item in pageProduct.includes %}<li>{{ item }}</li>{% endfor %}</ul><div class="fit-grid"><div><h3>A useful starting point for</h3><p>Students revisiting database concepts and looking for a compact revision companion.</p></div><div><h3>Check your course first</h3><p>No university syllabus or exam coverage is guaranteed. Use your course materials to check scope and verify important answers.</p></div></div></section>
            </div>
            <section class="review-section" aria-labelledby="reviewsHeading">
                <div class="section-title"><div><p class="eyebrow">Read with confidence</p><h2 id="reviewsHeading">Reviews &amp; content quality</h2></div><a href="#qualityReview">View review status ↗</a></div>
                <div class="review-layout">
                    <article class="quality-card" id="qualityReview" aria-labelledby="qualityHeading"><p class="review-status">{% if reviewContent.expertReview.status == 'published' %}Expert review published{% else %}Expert review pending{% endif %}</p><h3 id="qualityHeading">Subject review</h3>{% if reviewContent.expertReview.status == 'published' %}<p><strong>{{ reviewContent.expertReview.name | escape }}</strong> · {{ reviewContent.expertReview.qualifications | escape }}</p><p>Reviewed on <time datetime="{{ reviewContent.expertReview.reviewedOn }}">{{ reviewContent.expertReview.reviewedOn }}</time></p><p><strong>Scope:</strong> {{ reviewContent.expertReview.scope | escape }}</p><p>{{ reviewContent.expertReview.summary | escape }}</p>{% else %}<p>We haven't published an independent subject review of these notes yet. They are an AI-assisted draft, so check important explanations against your textbook or course materials.</p><p class="quality-next">An expert review should identify the reviewer, their subject experience, the review date, and the topics checked.</p>{% endif %}<a href="mailto:support@onlinepdfpro.com?subject=DBMS%20notes%20correction">Report a content error ↗</a></article>
                    <div class="reader-reviews" aria-labelledby="readerReviewsHeading"><div class="reader-review-heading"><h3 id="readerReviewsHeading">Reader reviews</h3>{% if reviewContent.count %}<span class="review-average">{{ reviewContent.average }} / 5 · {{ reviewContent.count }} review{% if reviewContent.count != 1 %}s{% endif %}</span>{% endif %}</div>{% if reviewContent.count %}{% for review in reviewContent.reviews %}<article class="reader-review"><div class="review-byline"><strong>{{ review.displayName | escape }}</strong><span>{{ review.rating }} / 5</span></div><p class="review-meta">{% if review.verifiedPurchase %}Purchase verified{% else %}Reader feedback{% endif %} · <time datetime="{{ review.publishedOn }}">{{ review.publishedOn }}</time></p><p>{{ review.text | escape }}</p></article>{% endfor %}{% else %}<div class="reviews-empty"><span class="review-empty-icon" aria-hidden="true">“</span><p class="empty-title">No published reviews yet</p><p>Read the sample and judge the fit for your course. If you've used these notes, share what helped and what could be improved.</p></div>{% endif %}<button class="review-write-button" id="writeReviewButton" type="button">Share a review</button><p class="review-moderation">Reviews are checked before publication. A purchase is labelled verified only after we confirm it; your rating does not affect whether an honest review is published.</p></div>
                </div>
            </section>
            <section class="purchase-faq" aria-labelledby="purchaseFaqHeading"><p class="eyebrow">A few practical details</p><h2 id="purchaseFaqHeading">Before you check out</h2><details><summary>How do I get my PDF?</summary><p>Sign in and complete checkout. After the payment is verified, the PDF is available in <a href="/library.html">My Library</a>. Use the same account when you return. This is a digital download, not a printed book.</p></details><details><summary>Are these notes expert-verified?</summary><p>Check the subject-review status above. Until an attributed expert review is published, treat this material as an AI-assisted draft and verify important explanations yourself.</p></details><details><summary>What if I paid but can't access the notes?</summary><p>Open My Library using the account you bought with. If the purchase is missing, contact <a href="mailto:support@onlinepdfpro.com">support@onlinepdfpro.com</a> with your payment reference. Avoid paying a second time before checking with support.</p></details><details><summary>Can I request a refund?</summary><p>Digital sales are generally final. The refund policy covers issues such as failed delivery, corrupted files, duplicate charges, or a product significantly different from its description. Request help within 7 days of purchase. <a href="/refund.html">Read the full refund policy</a> before buying.</p></details></section>
        </div>
        <div id="detailError" class="detail-error" hidden><h1>Study material not found</h1><p>That PDF is not available right now.</p><a href="/study-materials.html">Browse study materials</a></div>
    </main>

    <dialog class="preview-dialog" id="previewDialog" aria-labelledby="dialogTitle"><div class="dialog-head"><h2 id="dialogTitle">Preview page</h2><button class="dialog-close" id="dialogClose" type="button" aria-label="Close preview">×</button></div><div class="dialog-body"><img id="dialogImage" src="" alt=""></div><div class="dialog-footer"><span id="dialogPage">Page 1 of 5</span><div class="dialog-nav"><button id="dialogPrev" type="button" aria-label="Previous page">←</button><button id="dialogNext" type="button" aria-label="Next page">→</button></div></div></dialog>

    <dialog class="review-dialog" id="reviewDialog" aria-labelledby="reviewDialogHeading"><div class="dialog-head"><h2 id="reviewDialogHeading">Share your experience</h2><button class="dialog-close" id="reviewClose" type="button" aria-label="Close review form">×</button></div><form id="reviewForm" data-product-id="{{ pageProduct.id }}" data-product-title="{{ pageProduct.title }}"><p>Your review is sent by email for moderation. Preparing a draft does not submit it.</p><label for="reviewName">Public display name<input id="reviewName" name="displayName" type="text" minlength="2" maxlength="60" required autocomplete="nickname" placeholder="The name shown with your review"></label><label for="reviewRating">Your rating<select id="reviewRating" name="rating" required><option value="">Choose a rating</option><option value="5">5 — Very useful</option><option value="4">4 — Useful</option><option value="3">3 — Mixed experience</option><option value="2">2 — Needs improvement</option><option value="1">1 — Not useful for me</option></select></label><label for="reviewText">Your review<textarea id="reviewText" name="review" minlength="20" maxlength="1500" rows="5" required placeholder="What helped? Were any explanations unclear or incorrect?"></textarea></label><p class="review-privacy">Your display name, rating and review may be published. Keep email addresses, payment references and other private information out of the review text.</p><label class="review-consent"><input id="reviewConsent" type="checkbox" required><span>I agree to publication of my display name, rating and review after moderation. My email and purchase details stay private.</span></label><button class="review-prepare-button" type="submit">Prepare email draft</button><p id="reviewDraftStatus" role="status" aria-live="polite"></p><div class="review-draft-actions"><a id="reviewEmailLink" class="review-email-link" href="mailto:support@onlinepdfpro.com" hidden>Open email draft</a><button id="reviewCopyButton" type="button" hidden>Copy review text</button></div></form></dialog>

