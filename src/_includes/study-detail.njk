    <script>
        document.addEventListener('DOMContentLoaded', function () {
        (function () {
            var params = new URLSearchParams(window.location.search);
            var productId = {% if detailProduct %}{{ detailProduct.id | json | safe }}{% else %}params.get('product') || 'dbms-notes'{% endif %};
            var product = (window.STORE_PRODUCTS || {})[productId];
            var content = document.getElementById('detailContent');
            var error = document.getElementById('detailError');
            if (!product) { content.hidden = true; error.hidden = false; return; }

            var money = '₹' + Number(product.price || 0);
            var previews = Array.isArray(product.previewPages) ? product.previewPages.slice(0, 5) : [];
            document.title = product.title + ' — ' + product.pageCount + '-page PDF Study Draft | OnlinePDFPro';
            document.getElementById('productTitle').textContent = product.title;
            document.getElementById('productDescription').textContent = product.description || 'A carefully prepared digital study guide for focused revision.';
            document.getElementById('pageCount').textContent = product.pageCount || '—';
            document.getElementById('format').textContent = product.format || 'PDF';
            document.getElementById('factPrice').textContent = money;
            document.getElementById('productPrice').textContent = money;
            document.getElementById('buyButton').textContent = 'Buy PDF · ' + money;
            document.getElementById('priceMeta').textContent = (product.format || 'PDF') + ' · ' + (product.pageCount || '—') + ' pages';
            document.getElementById('previewCount').textContent = previews.length + '-page preview';
            document.getElementById('deliveryNote').textContent = product.deliveryNote || 'Instant digital access after secure checkout.';
            var disclosure = document.getElementById('disclosure');
            disclosure.replaceChildren();
            var disclosureLabel = document.createElement('strong');
            disclosureLabel.textContent = 'Before you buy.';
            disclosure.append(disclosureLabel, document.createTextNode(' ' + (product.disclosure || 'Review the material before relying on it for important decisions.')));

            var list = document.getElementById('includedList');
            list.replaceChildren();
            (product.includes || []).forEach(function (item) { var li = document.createElement('li'); li.textContent = item; list.appendChild(li); });

            var grid = document.getElementById('previewGrid');
            grid.replaceChildren();
            var dialog = document.getElementById('previewDialog');
            var dialogImage = document.getElementById('dialogImage');
            var dialogPage = document.getElementById('dialogPage');
            var currentIndex = 0;
            function renderDialog(index) {
                currentIndex = Math.max(0, Math.min(previews.length - 1, index));
                dialogImage.src = previews[currentIndex];
                dialogImage.alt = product.title + ' preview, page ' + (currentIndex + 1) + ' of ' + previews.length;
                dialogPage.textContent = 'Page ' + (currentIndex + 1) + ' of ' + previews.length;
                document.getElementById('dialogPrev').disabled = currentIndex === 0;
                document.getElementById('dialogNext').disabled = currentIndex === previews.length - 1;
            }
            previews.forEach(function (source, index) {
                var button = document.createElement('button');
                button.type = 'button'; button.className = 'preview-thumb'; button.setAttribute('aria-label', 'Open preview page ' + (index + 1));
                var image = document.createElement('img'); image.src = source; image.alt = 'Preview page ' + (index + 1); image.width = 612; image.height = 792; image.loading = index === 0 ? 'eager' : 'lazy';
                var label = document.createElement('span'); label.textContent = 'Page ' + (index + 1);
                button.appendChild(image); button.appendChild(label);
                button.addEventListener('click', function () { renderDialog(index); if (typeof dialog.showModal === 'function') dialog.showModal(); else dialog.setAttribute('open', ''); });
                grid.appendChild(button);
            });
            document.getElementById('addCartButton').addEventListener('click', function () { addToCart(product.id); });
            document.getElementById('buyButton').addEventListener('click', async function () {
                var button = this;
                if (button.disabled) return;
                button.disabled = true;
                button.setAttribute('aria-busy', 'true');
                button.textContent = 'Opening checkout…';
                document.getElementById('purchaseStatus').textContent = '';
                try { await buyProduct(product.id); }
                catch (checkoutError) { document.getElementById('purchaseStatus').textContent = 'Checkout could not open. Please try again or contact support.'; }
                finally { button.disabled = false; button.removeAttribute('aria-busy'); button.textContent = 'Buy PDF · ' + money; }
            });
            document.getElementById('dialogClose').addEventListener('click', function () { dialog.close(); });
            document.getElementById('dialogPrev').addEventListener('click', function () { renderDialog(currentIndex - 1); });
            document.getElementById('dialogNext').addEventListener('click', function () { renderDialog(currentIndex + 1); });
            dialog.addEventListener('click', function (event) { if (event.target === dialog) dialog.close(); });
            document.addEventListener('keydown', function (event) { if (!dialog.open) return; if (event.key === 'ArrowLeft') renderDialog(currentIndex - 1); if (event.key === 'ArrowRight') renderDialog(currentIndex + 1); });
        }());
        });
    </script>
</body>
