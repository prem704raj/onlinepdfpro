{% extends "base.njk" %}
{% block head %}
<style>
  .editorial-page {
    max-width: 860px;
    margin: 8px auto 64px;
    padding: 0 24px;
  }
  .editorial-hero {
    text-align: center;
    margin-bottom: 32px;
  }
  .editorial-hero h1 {
    margin: 0 auto 10px !important;
    text-align: center;
  }
  .editorial-meta {
    margin: 0 auto;
    max-width: 640px;
    color: var(--text-secondary, #6b5e4f);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .editorial-grid {
    display: grid;
    gap: 18px;
  }
  .editorial-card {
    padding: 26px 30px;
    border-radius: 12px;
    border: 1px solid var(--border, #d9d0c3);
    background: var(--surface-1, #fffdf9);
    box-shadow: 0 6px 20px rgba(44, 36, 24, 0.04);
  }
  [data-theme="dark"] .editorial-card {
    background: #242019;
    border-color: #3a342a;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
  }
  .editorial-card h2 {
    margin: 0 0 10px;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.32rem;
    font-weight: 600;
    color: var(--text-primary, #2c2418);
  }
  .editorial-card h3 {
    margin: 14px 0 6px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #2c2418);
  }
  .editorial-card p {
    margin: 0 0 12px;
    color: var(--text-secondary, #6b5e4f);
    font-size: 0.94rem;
    line-height: 1.68;
  }
  .editorial-card p:last-child {
    margin-bottom: 0;
  }
  .editorial-card ul,
  .editorial-card ol {
    margin: 8px 0 0;
    padding-left: 20px;
    color: var(--text-secondary, #6b5e4f);
    font-size: 0.93rem;
    line-height: 1.68;
    display: grid;
    gap: 8px;
  }
  .editorial-card a {
    color: var(--accent, #8b6914);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 640px) {
    .editorial-page {
      padding: 0 16px;
      margin: 8px auto 48px;
    }
    .editorial-card {
      padding: 20px 18px;
    }
  }
</style>
{% endblock %}
{% block content %}
<div class="editorial-page">
  {{ content | safe }}
</div>
{% endblock %}
