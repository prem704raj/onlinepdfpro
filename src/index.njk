---
title: Free Online PDF Tools & Simple Document Utilities
description: Free PDF tools for simple document tasks; choose a file and download a result. Merge, split, compress, edit and convert PDFs with 100% in-browser processing.
bodyClass: hp-body
---
{% extends "base.njk" %}
{% block head %}
<style>
/* ═══════════════════════════════════════════════
   HOMEPAGE — Warm Editorial Design System
   ═══════════════════════════════════════════════ */
:root { --hp-bg: #f6f5f0; --hp-bg-alt: #efe9de; --hp-bg-dark: #1c1610; --hp-text: #2c2418; --hp-text-secondary: #6b5e4f; --hp-text-muted: #706558; --hp-accent: #8b6914; --hp-accent-hover: #a47d1b; --hp-border: #d9d0c3; --hp-card-bg: transparent; --hp-serif: 'Playfair Display', Georgia, 'Times New Roman', serif; --hp-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
[data-theme="dark"] { --hp-bg: #1a1714; --hp-bg-alt: #242019; --hp-bg-dark: #0f0d0a; --hp-text: #f0ebe2; --hp-text-secondary: #a89e8f; --hp-text-muted: #8c8273; --hp-accent: #d4a942; --hp-accent-hover: #e6be5a; --hp-border: #3a342a; --hp-card-bg: #2a2520; }
body.hp-body { background: var(--hp-bg) !important; color: var(--hp-text) !important; }
body.hp-body main { padding-top: 0 !important; border: none !important; }
body.hp-body section, body.hp-body main { border-top: none !important; border-bottom: none !important; }
body.hp-body .header { background: #f6f5f0 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; border: 1px solid var(--hp-border) !important; border-bottom: none !important; box-shadow: 0 4px 20px rgba(44,36,24,0.08) !important; }
[data-theme="dark"] body.hp-body .header { background: #1a1714 !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; border: 1px solid #4a4238 !important; box-shadow: 0 4px 20px rgba(0,0,0,0.3) !important; }
body.hp-body .header .logo-text { color: var(--hp-text) !important; }
body.hp-body .header .nav-link { color: var(--hp-text-secondary) !important; }
body.hp-body .header .nav-link:hover { color: var(--hp-text) !important; }
body.hp-body .header .theme-toggle { color: var(--hp-text) !important; border: none !important; }
body.hp-body .header .menu-toggle { color: var(--hp-text) !important; }
body.hp-body .header .desktop-only-action { color: var(--hp-text) !important; border: none !important; }
body.hp-body .header .header-search, body.hp-body .header .mobile-search-toggle { display: none !important; }
.hp-hero { position: relative; width: 100%; min-height: auto; display: flex; align-items: flex-start; justify-content: center; overflow: hidden; background: transparent; border: none; }
.hp-hero::before { display: none !important; }
.hp-hero::after { display: none !important; }
.hp-hero-content { position: relative; z-index: 3; text-align: center; max-width: 1200px; padding: 0 24px; padding-top: 100px; padding-bottom: 36px; }
.hp-hero-label { font-family: var(--hp-sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--hp-accent); margin-bottom: 24px; }
.hp-hero-heading { font-family: var(--hp-serif); font-size: clamp(1.8rem, 3.2vw, 3rem); font-weight: 400; font-style: italic; line-height: 1.25; color: var(--hp-accent); max-width: 1200px; margin: 0 auto 24px; letter-spacing: -0.01em; white-space: normal; text-wrap: balance; }
@media (max-width: 850px) {
  .hp-hero-heading { white-space: normal; overflow-wrap: anywhere; font-size: clamp(1.8rem, 6vw, 2.5rem); }
}
@media (max-width: 768px) {
  .hp-hero-content { width: 100%; max-width: 100%; padding: 72px 20px 32px; box-sizing: border-box; }
  .hp-hero-heading { width: 100%; max-width: 100%; font-size: clamp(1.6rem, 8vw, 2.2rem); white-space: normal; overflow-wrap: anywhere; }
  .hp-hero-subtitle { max-width: 100%; white-space: normal; }
}
.hp-hero-heading em { font-style: italic; color: var(--hp-accent); }
.hp-hero-subtitle { font-family: var(--hp-sans); font-size: 1rem; color: var(--hp-text-secondary); line-height: 1.75; max-width: 950px; margin: 0 auto 44px; white-space: normal; }
.hp-hero-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.hp-btn { box-sizing: border-box; font-family: var(--hp-sans); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; padding: 16px 40px; border: 1.5px solid var(--hp-text); background: transparent; color: var(--hp-text); text-decoration: none; transition: all 0.35s ease; cursor: pointer; display: inline-block; }
.hp-btn:hover { opacity: 0.8; }
.hp-btn-filled { background: var(--hp-accent); color: #fff; border-color: var(--hp-accent); }
.hp-btn-filled:hover { background: var(--hp-accent-hover); color: #fff; border-color: var(--hp-accent-hover); }
.hp-section { padding: 90px 24px; }
.hp-container { max-width: 1100px; margin: 0 auto; box-sizing: border-box; }
.hp-label { font-family: var(--hp-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--hp-text-muted); margin-bottom: 14px; }
.hp-section-heading { font-family: var(--hp-serif); font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 400; color: var(--hp-text); line-height: 1.2; margin-bottom: 18px; letter-spacing: -0.01em; }
.hp-section-heading em { font-style: italic; }
.hp-section-desc { font-family: var(--hp-sans); font-size: 0.92rem; color: var(--hp-text-secondary); line-height: 1.75; max-width: 900px; }

/* Flagship Showcase */
.hp-tools-section { background: var(--hp-bg-alt); }
.hp-tools-header { text-align: center; margin-bottom: 48px; }
.hp-tools-header .hp-section-desc { margin: 0 auto; }
.hp-tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 48px; }
@media (max-width: 1024px) { .hp-tools-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { .hp-tools-grid { grid-template-columns: 1fr; } }
.hp-tool-item { display: flex; align-items: flex-start; gap: 18px; padding: 24px 22px; background: var(--hp-card-bg); border: 1px solid var(--hp-border); text-decoration: none; color: inherit; transition: all 0.3s ease; box-sizing: border-box; }
.hp-tool-item:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(44,36,24,0.06); border-color: var(--hp-accent); }
.hp-tool-icon-wrap { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
.hp-tool-icon-wrap svg { width: 22px; height: 22px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.hp-tool-content { flex: 1; }
.hp-tool-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; flex-wrap: wrap; }
.hp-tool-name { font-family: var(--hp-serif); font-size: 1.05rem; font-weight: 500; color: var(--hp-text); margin: 0; }
.hp-tool-badge { font-family: var(--hp-sans); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 7px; border-radius: 4px; background: rgba(139, 105, 20, 0.12); color: var(--hp-accent); }
.hp-tool-desc { font-family: var(--hp-sans); font-size: 0.78rem; color: var(--hp-text-muted); line-height: 1.5; margin-bottom: 10px; }
.hp-tool-cta-link { font-family: var(--hp-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--hp-accent); display: inline-flex; align-items: center; gap: 6px; }
.hp-tools-cta { text-align: center; }
.hp-btn-warm { box-sizing: border-box; font-family: var(--hp-sans); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; padding: 16px 44px; border: 1.5px solid var(--hp-text); background: transparent; color: var(--hp-text); text-decoration: none; transition: all 0.35s ease; display: inline-block; }
.hp-btn-warm:hover { opacity: 0.8; }

/* Privacy & Processing Transparency Box */
.hp-privacy-boundary { background: var(--hp-bg); }
.hp-privacy-box { border: 1px solid var(--hp-border); background: var(--hp-card-bg); padding: 40px 36px; box-sizing: border-box; }
.hp-privacy-header { display: flex; align-items: center; gap: 20px; margin-bottom: 28px; }
.hp-privacy-shield { font-size: 2.2rem; line-height: 1; color: var(--hp-accent); }
.hp-privacy-title { font-family: var(--hp-serif); font-size: 1.35rem; font-weight: 500; color: var(--hp-text); margin: 0 0 4px; }
.hp-privacy-subtitle { font-family: var(--hp-sans); font-size: 0.88rem; color: var(--hp-text-secondary); margin: 0; }
.hp-privacy-columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; border-top: 1px solid var(--hp-border); padding-top: 28px; }
@media (max-width: 900px) { .hp-privacy-columns { grid-template-columns: 1fr; gap: 20px; } }
.hp-privacy-col h4 { font-family: var(--hp-serif); font-size: 1.05rem; font-weight: 500; color: var(--hp-text); margin: 8px 0 6px; }
.hp-privacy-col p { font-family: var(--hp-sans); font-size: 0.82rem; color: var(--hp-text-secondary); line-height: 1.6; margin: 0; }
.hp-privacy-pill { display: inline-block; font-family: var(--hp-sans); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; margin-bottom: 6px; }
.hp-pill-local { background: #dcfce7; color: #166534; }
[data-theme="dark"] .hp-pill-local { background: #14532d; color: #86efac; }
.hp-pill-server { background: #e0f2fe; color: #075985; }
[data-theme="dark"] .hp-pill-server { background: #0c4a6e; color: #7dd3fc; }
.hp-pill-ai { background: #fef3c7; color: #92400e; }
[data-theme="dark"] .hp-pill-ai { background: #78350f; color: #fde68a; }

/* Offerings & Guides */
.hp-offerings { background: var(--hp-bg-alt); }
.hp-offerings-header { text-align: center; margin-bottom: 56px; }
.hp-offerings-header .hp-section-desc { margin: 0 auto; }
.hp-offerings-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
@media (max-width: 1024px) { .hp-offerings-grid { grid-template-columns: 1fr; gap: 16px; } }
.hp-offering-card { background: var(--hp-card-bg); border: 1px solid var(--hp-border); padding: 44px 32px 36px; text-align: left; text-decoration: none; color: inherit; transition: all 0.4s ease; position: relative; overflow: hidden; box-sizing: border-box; }
.hp-offering-card:hover { transform: translateY(-4px); box-shadow: 0 16px 48px rgba(44,36,24,0.07); }
.hp-offering-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; color: var(--hp-accent); }
.hp-offering-icon svg { width: 28px; height: 28px; stroke: currentColor; fill: none; stroke-width: 1.5; }
.hp-offering-title { font-family: var(--hp-serif); font-size: 1.3rem; font-weight: 500; color: var(--hp-text); margin-bottom: 10px; }
.hp-offering-desc { font-family: var(--hp-sans); font-size: 0.85rem; color: var(--hp-text-secondary); line-height: 1.7; margin-bottom: 24px; }
.hp-offering-link { font-family: var(--hp-sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--hp-accent); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: gap 0.3s ease; }
.hp-offering-card:hover .hp-offering-link { gap: 14px; }
.hp-offering-badge { display: inline-block; font-family: var(--hp-sans); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; padding: 4px 10px; border: 1px solid var(--hp-accent); color: var(--hp-accent); margin-bottom: 18px; }

/* Separated Supplementary Study Drafts */
.hp-study-section { background: var(--hp-bg); }
.hp-study-box { border: 1px solid var(--hp-border); padding: 44px 36px; max-width: 950px; margin: 0 auto; background: var(--hp-card-bg); text-align: center; box-sizing: border-box; }
.hp-study-box .hp-section-desc { margin: 0 auto 28px; }

/* Philosophy & Stats */
.hp-philosophy { background: var(--hp-bg); }
.hp-philosophy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
@media (max-width: 1024px) { .hp-philosophy-grid { grid-template-columns: 1fr; gap: 40px; } .hp-philosophy-visual { order: -1; } }
.hp-philosophy-visual { display: flex; align-items: center; justify-content: center; }
.hp-philosophy-art { width: 100%; max-width: 360px; aspect-ratio: 1; position: relative; }
.hp-philosophy-art::before { content: ''; position: absolute; inset: 12%; border: 1px solid var(--hp-border); transform: rotate(45deg); }
.hp-philosophy-art::after { content: ''; position: absolute; inset: 28%; border: 1px solid var(--hp-border); opacity: 0.4; }
.hp-philosophy-art-inner { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 100px; height: 100px; background: var(--hp-accent); opacity: 0.07; border-radius: 50%; }
.hp-feature-list { list-style: none; padding: 0; margin: 28px 0 0; }
.hp-feature-list li { font-family: var(--hp-sans); font-size: 0.88rem; color: var(--hp-text-secondary); padding: 11px 0; border-bottom: 1px solid var(--hp-border); display: flex; align-items: center; gap: 12px; }
.hp-feature-list li::before { content: '·'; font-size: 1.5rem; color: var(--hp-accent); line-height: 1; }
.hp-stats { background: var(--hp-bg-dark); padding: 64px 24px; }
.hp-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; max-width: 1100px; margin: 0 auto; text-align: center; }
@media (max-width: 768px) { .hp-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
.hp-stat-number { font-family: var(--hp-serif); font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; color: #f0ebe2; margin-bottom: 8px; }
.hp-stat-label { font-family: var(--hp-sans); font-size: 0.62rem; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(240,235,226,0.35); }

.hp-fade-up { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.hp-fade-up.visible { opacity: 1; transform: translateY(0); }
.hp-info-section { background: var(--hp-bg-alt); }
.hp-workflow-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.hp-workflow-grid a { display: block; padding: 18px 20px; border: 1px solid var(--hp-border); color: var(--hp-text-secondary); text-decoration: none; font-size: 0.88rem; line-height: 1.5; transition: border-color 0.2s, color 0.2s, transform 0.2s; }
.hp-workflow-grid a span { color: var(--hp-accent); font-weight: 600; }
.hp-workflow-grid a:hover { border-color: var(--hp-accent); color: var(--hp-text); transform: translateY(-2px); }

@media (max-width: 768px) {
  .hp-section { padding: 48px 16px; box-sizing: border-box; }
  .hp-container { width: 100%; box-sizing: border-box; }
  .hp-hero-ctas { flex-direction: column; align-items: center; }
  .hp-btn, .hp-btn-warm { box-sizing: border-box; width: 100%; max-width: 260px; text-align: center; padding: 14px 20px; }
  .hp-philosophy-art { max-width: 240px; }
  .hp-offering-card { padding: 24px 16px; box-sizing: border-box; }
  .hp-tool-item { padding: 16px 14px; gap: 12px; box-sizing: border-box; }
  .hp-privacy-box { padding: 24px 16px; box-sizing: border-box; }
  .hp-privacy-header { gap: 14px; }
  .hp-study-box { padding: 24px 16px; box-sizing: border-box; }
  .hp-workflow-grid { grid-template-columns: 1fr; gap: 16px; }
}
</style>
{% endblock %}

{% block content %}
<!-- ═══════ HERO ═══════ -->
<section class="hp-hero">
    <div class="hp-hero-content">
        <p class="hp-hero-label">Simple, Fast & Private</p>
        <h1 class="hp-hero-heading"><em>Free PDF tools for simple document tasks; choose a file and download a result.</em></h1>
        <p class="hp-hero-subtitle">Fast, private document utilities in your browser. Combine assignment pages, compress files for portal uploads, split documents, edit text, and turn photos into clean PDFs. Standard tools process locally on your device with zero file upload.</p>
        <div class="hp-hero-ctas">
            <a href="{{ '/tools' | url }}" class="hp-btn hp-btn-filled">Explore Tools</a>&#32;
            <a href="/assets/examples/onlinepdfpro-practice-pack.zip" download="onlinepdfpro-practice-pack.zip" class="hp-btn">Try the Examples</a>
        </div>
    </div>
</section>

<!-- ═══════ FIVE FLAGSHIP WORKFLOWS (ABOVE THE DIRECTORY) ═══════ -->
<section class="hp-section hp-tools-section" id="flagship">
    <div class="hp-container">
        <div class="hp-tools-header hp-fade-up">
            <p class="hp-label">Start Here</p>
            <h2 class="hp-section-heading">Free tools for <em>real document tasks</em></h2>
            <p class="hp-section-desc">Merge, split, compress, edit or turn images into a PDF. Five core workflows processed locally in your browser — your files remain private and never leave your device.</p>
        </div>
        <div class="hp-tools-grid">
            {% for tool in toolRegistry.tools %}
            {% if tool.featured %}
            <a href="{{ tool.href | url }}" class="hp-tool-item hp-fade-up">
                <div class="hp-tool-icon-wrap" style="background: {{ tool.color }};"><svg viewBox="0 0 24 24">{{ tool.svg | safe }}</svg></div>
                <div class="hp-tool-content">
                    <div class="hp-tool-header">
                        <div class="hp-tool-name">{{ tool.name }}</div>
                        <span class="hp-tool-badge">Local · Zero Upload</span>
                    </div>
                    <div class="hp-tool-desc">{{ tool.desc }}</div>
                    <span class="hp-tool-cta-link">Open Tool <span>→</span></span>
                </div>
            </a>
            {% endif %}
            {% endfor %}
        </div>
        <div class="hp-tools-cta hp-fade-up">
            <a href="{{ '/tools' | url }}" class="hp-btn-warm">View All 46 Free Tools</a>
        </div>
    </div>
</section>

<!-- ═══════ TRANSPARENT PROCESSING & PRIVACY BOUNDARIES ═══════ -->
<section class="hp-section hp-privacy-boundary" id="privacy-boundary">
    <div class="hp-container">
        <div class="hp-privacy-box hp-fade-up">
            <div class="hp-privacy-header">
                <span class="hp-privacy-shield">🔒</span>
                <div>
                    <h3 class="hp-privacy-title">Transparent Processing & Privacy Boundaries</h3>
                    <p class="hp-privacy-subtitle">We clearly disclose how every document is handled before you choose a file.</p>
                </div>
            </div>
            <div class="hp-privacy-columns">
                <div class="hp-privacy-col">
                    <span class="hp-privacy-pill hp-pill-local">100% Client-Side</span>
                    <h4>Local Browser Memory</h4>
                    <p>Merge PDF, Compress PDF, Split PDF, JPG to PDF, and PDF Editor execute in your browser via WebAssembly & Canvas. Your files are never uploaded to any server.</p>
                </div>
                <div class="hp-privacy-col">
                    <span class="hp-privacy-pill hp-pill-server">Server-Assisted</span>
                    <h4>Protected Ephemeral Gateways</h4>
                    <p>Format conversions like PDF to Word and Word to PDF run on an isolated conversion service. Documents are encrypted in transit and purged immediately after completion.</p>
                </div>
                <div class="hp-privacy-col">
                    <span class="hp-privacy-pill hp-pill-ai">Opt-In Cloud AI</span>
                    <h4>Explicit Interaction Only</h4>
                    <p>AI tools such as Chat with PDF, Summarizer, and Flashcards call secure AI language models only after you explicitly click to analyze text.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════ FULL DIRECTORY & TASK GUIDES ═══════ -->
<section class="hp-section hp-offerings" id="offerings">
    <div class="hp-container">
        <div class="hp-offerings-header hp-fade-up">
            <p class="hp-label">Explore More</p>
            <h2 class="hp-section-heading">Built for <em>reliable document work</em></h2>
            <p class="hp-section-desc">Search the full 46-tool collection or follow step-by-step walkthroughs with downloadable sample files.</p>
        </div>
        <div class="hp-offerings-grid">
            <a href="{{ '/tools' | url }}" class="hp-offering-card hp-fade-up">
                <div class="hp-offering-badge">46 Free Tools</div>
                <div class="hp-offering-icon">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </div>
                <h3 class="hp-offering-title">Searchable Tool Directory</h3>
                <p class="hp-offering-desc">Explore all 46 tools organized by task: Organize & Pages, Optimize & Convert, Edit & Secure, and AI & Productivity. Instant search and zero signup needed.</p>
                <span class="hp-offering-link">Browse All 46 Tools <span>→</span></span>
            </a>
            <a href="/assets/examples/onlinepdfpro-practice-pack.zip" download="onlinepdfpro-practice-pack.zip" class="hp-offering-card hp-fade-up">
                <div class="hp-offering-badge">Practice Pack (ZIP)</div>
                <div class="hp-offering-icon">
                    <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                <h3 class="hp-offering-title">Official Practice Pack</h3>
                <p class="hp-offering-desc">Download non-sensitive test files including Word documents, multi-page assignments, and exam admit cards to safely test tools locally before working with real files.</p>
                <span class="hp-offering-link">Download Practice Pack (ZIP) <span>↓</span></span>
            </a>
        </div>
    </div>
</section>

<!-- ═══════ PHILOSOPHY ═══════ -->
<section class="hp-section hp-philosophy">
    <div class="hp-container">
        <div class="hp-philosophy-grid">
            <div class="hp-philosophy-visual hp-fade-up">
                <div class="hp-philosophy-art">
                    <div class="hp-philosophy-art-inner"></div>
