# ── Service URLs ──────────────────────────────────────────────
DOCX2PDF_URL=http://docx2pdf:8000
PDF2DOCX_MODAL_URL=https://YOUR_MODAL_USERNAME--pdf2docx-convert.modal.run

# ── Gateway settings ─────────────────────────────────────────
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=10
MAX_FILE_SIZE_MB=50

# ── Auth ─────────────────────────────────────────────────────
# Required in production. The gateway and the internal DOCX service must share
# this value; leave blank only for a local development stack.
API_KEY=
DOCX2PDF_API_TOKEN=

# Bearer token shared by the gateway and the protected Modal endpoint
MODAL_API_TOKEN=

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://onlinepdfpro.com,http://localhost:3000
